# Copy to .env and adjust. Every value below is optional - these are the defaults.

APP_NAME=Nexus PM
API_V1=/api

# Change this before deploying anywhere real.
SECRET_KEY=change-me-in-production-4f9c1d2b8a6e5f3c7d0b9a1e2f4c6d8b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Any SQLAlchemy URL. Defaults to pmt.db next to this file.
DATABASE_URL=sqlite:///./pmt.db

# JSON list - the Vite dev server and preview server by default.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://localhost:3000"]

# Insert the demo workspace on startup when the database has no users yet.
SEED_DEMO_DATA=true
